# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# Synology: /docker/kospi-backtest/.env  (docker-compose.yml 과 같은 폴더)

# ── 모의투자 (먼저 이걸로 시작하세요) ──
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
# 모의투자 계좌번호 8자리-2자리
KIS_MOCK_ACCOUNT=

# ── 실전 (선택) 시세 조회가 빨라집니다(초당 20건). 계좌번호는 실전 주문할 때만 필요 ──
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT=

# 주문·잔고 대상: mock(기본) | real
KIS_TRADE_ENV=mock
# 실전 주문 안전장치. 실전으로 주문하려면 KIS_TRADE_ENV=real 과 함께 yes 로
KIS_ALLOW_REAL_ORDERS=

# 주문·잔고 화면 비밀번호. 비워 두면 주문·잔고 기능이 꺼집니다. 길고 무작위로 정하세요.
TRADE_API_TOKEN=
