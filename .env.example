# 대부분의 설정은 웹 화면 http://NAS-IP:3000/settings 에서 합니다. 이 파일은 없어도 됩니다.
# 쓰려면 .env 로 복사해서 docker-compose.yml 과 같은 폴더에 둡니다. (.env 는 git 에 올라가지 않습니다)

# ── 실전 주문 잠금 해제 (환경변수로만 가능) ──
# 설정 화면에서 주문 대상을 '실전'으로 고르고, 여기까지 yes 로 해야 실제 돈으로 주문이 나갑니다.
# 화면 비밀번호가 새더라도 실전 주문은 나가지 않도록 일부러 화면에서 못 바꾸게 했습니다.
KIS_ALLOW_REAL_ORDERS=

# ── 선택: 관리자 비밀번호를 화면 대신 여기서 고정 ──
# 비워 두면 처음 /settings 에 들어갈 때 화면에서 만듭니다 (컨테이너 로그의 설정 코드 필요).
ADMIN_PASSWORD=

# ── 고급: 화면 값 대신 환경변수로 고정하고 싶을 때만 (값이 있으면 화면 값보다 우선) ──
# 쓰려면 docker-compose.yml 의 environment: 에도 같은 줄을 추가해야 합니다.
# KIS_MOCK_APP_KEY=
# KIS_MOCK_APP_SECRET=
# KIS_MOCK_ACCOUNT=
# KIS_REAL_APP_KEY=
# KIS_REAL_APP_SECRET=
# KIS_REAL_ACCOUNT=
# KIS_TRADE_ENV=mock
